#!/command/with-contenv sh
# Startprüfung als unprivilegierter Web-Benutzer, ohne Capabilities.
# Schlägt sie fehl, beendet sich der Container (S6_BEHAVIOUR_IF_STAGE2_FAILS=2).
exec setpriv --reuid=10001 --regid=10001 --clear-groups \
    --inh-caps=-all --bounding-set=-all --no-new-privs \
    -- /app/.venv/bin/twinraid-preflight
