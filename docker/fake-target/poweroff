#!/usr/bin/env python3
"""Platzhalter für /sbin/poweroff: Groß „schaltet aus“ (alle VMs aus, Port 80 zu)."""

import json
from pathlib import Path

STATE = Path("/state")
with (STATE / "poweroff.log").open("a") as handle:
    handle.write("poweroff\n")
vms = json.loads((STATE / "vms.json").read_text())
for vm in vms:
    vm["state"] = "shut off"
(STATE / "vms.json").write_text(json.dumps(vms))
(STATE / "power-off").touch()
